{
  "expo": {
    "name": "Go Unplugged",
    "slug": "go-unplugged",
    "version": "0.1.0",
    "scheme": "gounplugged",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08090B",
    "ios": {
      "bundleIdentifier": "com.gounplugged.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.gounplugged.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gounplugged.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#08090B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B34D0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.gounplugged.app.device-activity-monitor",
                  "targetName": "GoUnpluggedMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.gounplugged.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.gounplugged.app.device-activity-monitor",
                  "targetName": "GoUnpluggedMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.gounplugged.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "092bffe3-7193-4589-9b20-6b01f5d2c2de"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "itsjesus"
  }
}
