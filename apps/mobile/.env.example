# Copia este archivo a .env (no se sube a git) y completa con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API). La "publishable/anon key" es pública por diseño: la
# seguridad la dan las políticas RLS. NUNCA pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-o-anon-key
