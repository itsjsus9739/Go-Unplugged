<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Tiempo de uso por app (el usuario lo concede en Ajustes → Acceso a datos de uso) -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

  <!-- Listar apps con ícono de lanzador para elegir cuáles limitar (sin QUERY_ALL_PACKAGES) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.appblocker.BlockerAccessibilityService"
      android:exported="true"
      android:label="@string/appblocker_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/appblocker_accessibility_config" />
    </service>
  </application>
</manifest>
